# Open-NPU Yosys synthesis sanity flow
# Pass A: parse and hierarchy-check the top-level RTL and exact row-core ports.
# This is a bounded Yosys structural sanity pass, not a technology synthesis.
#
# npu_compute is syntax/lint checked by the RTL regression flow. It contains
# multi-write row buffers and large procedural lane loops
# that stock Yosys lowers into >50k mux decoders. Full compute synthesis belongs
# in the target backend after those buffers are mapped to macros; this script is
# intentionally a bounded source-list and top-level connectivity check.

read_verilog -sv -nomem2reg -DSYNTHESIS -I../include -DACC_WIDTH=44 \
    ../src/npu_sram.v \
    ../src/npu_sram_wide.v \
    ../src/npu_ppu.v \
    ../src/npu_ppu_bank.v \
    ../src/npu_dw_conv.v \
    ../src/npu_dw_bank.v \
    ../src/npu_csr.v \
    ../src/npu_dma.v \
    ../src/npu_ctrl.v \
    ../src/npu_top.v

# Read the exact production interface with its procedural body preprocessed
# away, avoiding an independently maintained stub port list.
read_verilog -sv -nomem2reg -DSYNTHESIS -DNPU_COMPUTE_BLACKBOX \
    -I../include -DACC_WIDTH=44 \
    ../src/npu_compute.v

blackbox npu_sram
blackbox npu_sram_wide
blackbox npu_ppu_bank
blackbox npu_dw_bank

hierarchy -check -top npu_top
check
stat
