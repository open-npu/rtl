# Open-NPU Yosys full RTL synthesis check (no npu_compute blackbox)
# Synthesizes all RTL control & compute datapaths including npu_compute,
# npu_ppu_bank, npu_dma, npu_csr, npu_ctrl, and npu_top.
# Top-level SRAM macros (npu_sram / npu_sram_wide) remain blackboxed as
# foundry memory macros; internal compute row buffers infer $mem_v2.

read_verilog -sv -DSYNTHESIS -I../include \
    ../src/npu_sram.v \
    ../src/npu_sram_wide.v

blackbox npu_sram
blackbox npu_sram_wide

read_verilog -defer -sv -DSYNTHESIS -I../include \
    ../src/npu_ppu.v \
    ../src/npu_ppu_bank.v \
    ../src/npu_csr.v \
    ../src/npu_dma.v \
    ../src/npu_ctrl.v \
    ../src/npu_compute.v \
    ../src/npu_top.v

hierarchy -check -top npu_top
proc
opt_expr
opt_clean
memory_dff
opt_clean
memory_collect
opt_clean
check
stat

